# ============================================================================
# 키움 자동매매 봇 설정 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 있으므로 커밋되지 않습니다.
# ============================================================================

# ---------------------------------------------------------------- 접속/인증
# 키움 REST API 포털(https://openapi.kiwoom.com)에서 발급받은 앱키/시크릿
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

# mock = 모의투자(mockapi.kiwoom.com) / real = 실계좌(api.kiwoom.com)
KIWOOM_ENV=mock

# true 면 주문 API 를 실제로 보내지 않고 로그만 남깁니다.
# 생략하면 KIWOOM_ENV=real 일 때 자동으로 true 가 됩니다(실계좌 안전장치).
DRY_RUN=false

# 국내거래소 구분: KRX / NXT / SOR
DMST_STEX_TP=KRX

# ---------------------------------------------------------------- 알림
NOTIFIER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# NOTIFIER=discord 로 쓸 경우
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------- 운용 시간
SCREENING_TIME=08:10
SESSION_START=09:00
NO_NEW_ENTRY_AFTER=14:30
FLATTEN_TIME=15:15
SESSION_END=15:25
EOD_REPORT_TIME=16:00

# ---------------------------------------------------------------- 스크리닝
UNIVERSE_MAX=20
UNIVERSE_MARKETS=KOSPI,KOSDAQ
MIN_TRADING_VALUE=5000000000
MIN_MARKET_CAP=100000000000
MIN_PRICE=2000
MAX_PRICE=500000
MA_TREND_PERIOD=60
VOLUME_SURGE_RATIO=1.5
# 스크리닝을 건너뛰고 특정 종목만 감시하려면 (테스트용)
# FIXED_UNIVERSE=005930,000660,035720

# ---------------------------------------------------------------- 시그널
SIGNAL_SCORE_THRESHOLD=4.0
RSI_PERIOD=14
MA_FAST=5
MA_SLOW=20
ATR_PERIOD=14
FACTOR_A_TURNOVER_RATIO=0.30
FACTOR_D_STRENGTH=110
WARMUP_BARS=120
REENTRY_COOLDOWN_SEC=600

# ---------------------------------------------------------------- 리스크/자금
# fixed_pct | atr_risk | half_kelly
SIZING_MODE=fixed_pct
POSITION_PCT=0.10
MAX_ORDER_AMOUNT=3000000
MIN_ORDER_AMOUNT=100000
MAX_POSITIONS=5

STOP_LOSS_PCT=-0.02
TAKE_PROFIT_PCT=0.03
TAKE_PROFIT_RATIO=0.5
TRAILING_STOP_PCT=-0.015
TIME_CUT_MIN=60
TIME_CUT_BAND_PCT=0.01
DAILY_LOSS_LIMIT_PCT=-0.03

# atr_risk 모드
RISK_PER_TRADE_PCT=0.005
ATR_STOP_MULT=1.5
# half_kelly 모드 (최근 30일 실적이 20건 이상 쌓이면 자동으로 그 값을 씁니다)
KELLY_FRACTION=0.5
KELLY_WIN_RATE=0.55
KELLY_PAYOFF=1.5
KELLY_CAP=0.20

# ---------------------------------------------------------------- 주문 집행
# 0=지정가 3=시장가 6=최유리지정가 7=최우선지정가 10=지정가IOC 13=시장가IOC
ENTRY_ORDER_TYPE=7
EXIT_ORDER_TYPE=3
UNFILLED_TIMEOUT_SEC=30
UNFILLED_MAX_CHASE=1
SLIPPAGE_GUARD_PCT=0.01

# ---------------------------------------------------------------- 메타 필터(ML)
# 데이터가 쌓이고 train_meta 로 모델을 만든 뒤에 true 로 바꾸세요.
META_FILTER_ENABLED=false
META_PROB_THRESHOLD=0.60
TB_UPPER_ATR_MULT=2.0
TB_LOWER_ATR_MULT=1.0
TB_VERTICAL_MIN=60

# ---------------------------------------------------------------- 기타
LOG_LEVEL=INFO
TZ_NAME=Asia/Seoul
REST_RATE_PER_SEC=4.0
REST_BURST=8
